<head>
  <title>{assigns[:page_title] || @socket.view.title()}</title>
</head>

<header>
  <nav>
    <.link navigate={~p"/home"} class={current_page?(@socket, LLWeb.MainLibraryLive)}>
      Home
    </.link>
    <div :if={assigns[:home_nav]} class="sub">{@home_nav}</div>

    <.link
      :if={@current_scope.user}
      navigate={~p"/library"}
      class={current_page?(@socket, LLWeb.LibraryLive)}
    >
      Library
    </.link>
    <div :if={assigns[:library_nav]} class="sub">{@library_nav}</div>

    <%= if @current_scope.user do %>
      {live_render(@socket, LLWeb.UpdatesNavLive,
        id: LLWeb.UpdatesNavLive,
        session: %{"user" => @current_scope.user}
      )}
      <.link navigate={~p"/user/settings"} class={current_page?(@socket, LLWeb.UserLive.Settings)}>
        Settings
      </.link>
      <.link href={~p"/user/log-out"} method="delete">Log out</.link>
    <% else %>
      <.link
        navigate={~p"/user/register"}
        class={current_page?(@socket, LLWeb.UserLive.Registration)}
      >
        Register
      </.link>
      <.link navigate={~p"/user/log-in"} class={current_page?(@socket, LLWeb.UserLive.Login)}>
        Log in
      </.link>
    <% end %>

    <%= if LL.User.mod?(@current_scope) do %>
      <.link
        navigate={~p"/admin/updates_all"}
        class={current_page?(@socket, LLWeb.UpdatesAllLive)}
      >
        Updates (All)
      </.link>
      <.link navigate={~p"/admin/search"} class={current_page?(@socket, LLWeb.SearchLive)}>
        Search
      </.link>
      <.link navigate={~p"/admin/status"} class={current_page?(@socket, LLWeb.StatusLive)}>
        Status
      </.link>
      <.link navigate={~p"/admin/routes"} class={current_page?(@socket, LLWeb.RoutesLive)}>
        Routes
      </.link>
      <.link navigate={~p"/admin/users"} class={current_page?(@socket, LLWeb.UsersLive)}>
        Users
      </.link>
    <% end %>
  </nav>
</header>

<main class="container">{@inner_content}</main>
