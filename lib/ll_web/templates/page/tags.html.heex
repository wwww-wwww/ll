<h1>Tags</h1>

<table>
  <%= for tag <- LL.Repo.all(LL.Tag) |> Enum.sort_by(& &1.id) do %>
    <tr>
      <td>
        <.link navigate={Routes.live_path(@socket, LLWeb.IndexLive, q: "\"#{tag.id}\"", page: 1)}>
          {tag.name}
        </.link>
      </td>

      <td>{tag_type(tag)}</td>
    </tr>
  <% end %>
</table>
