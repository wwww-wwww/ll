<div class="library">
  <%= for series <- @library do %>
    <.live_component
      module={LLWeb.SeriesComponent}
      id={LLWeb.SeriesComponent.id(series.id)}
      series={series}
      click={~p"/library/#{series.id}"}
    />
  <% end %>
</div>

<%= if assigns[:series] do %>
  <.live_component
    module={LLWeb.SeriesPageComponent}
    id={LLWeb.SeriesPageComponent.id(@series.id)}
    series_id={@series.id}
    close={~p"/"}
  />
<% end %>
