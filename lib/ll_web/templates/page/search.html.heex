<.form let={f} for={%{}} phx-submit="search">
  <%= text_input f, :query %>
  <%= submit "Search" %>
</.form>

<%= for {source_id, results} <- @search.results do %>
<h4><%= source_id %></h4>
<div>
    <%= for entry <- results do %>
    <div>
        <span><%= entry["title"] %></span>
    </div>
    <% end %>
</div>
<% end %>

<h3>Sources</h3>
<div>
    <%= for source <- @sources do %>
    <div>
        <span><%= source.id in @enabled_sources %></span>
        <span><%= source.name %></span>
        <span><%= source.lang %></span>
        <span><%= source.extension.pkg %></span>
        <span><%= source.source_id %></span>
    </div>
    <% end %>
</div>
