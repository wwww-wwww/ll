<h1>Status</h1>

<span><%= Application.get_env(:ll, :cjxl) %></span>
<div>
  <button phx-click="sync">Sync</button>
  <button phx-click="sync_series">Sync Series</button>
  <button phx-click="encode_pages">Encode</button>
</div>

<table>

<%= for {key, value} <- @status do %>
<tr>
  <td><%= key_string(key) %></td>
  <td><%= value %></td>
</tr>
<% end %>

</table>
